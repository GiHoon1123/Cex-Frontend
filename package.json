{
  "name": "cex-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "start:dev": "npm run dev --workspace @cex/exchange",
    "start:admin": "npm run dev --workspace @cex/admin",
    "build": "npm run build --workspace @cex/exchange && npm run build --workspace @cex/admin",
    "lint": "npm run lint --workspace @cex/exchange && npm run lint --workspace @cex/admin",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^20",
    "baseline-browser-mapping": "^2.9.5",
    "typescript": "^5"
  }
}
